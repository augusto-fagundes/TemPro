{
  "name": "tempro",
  "private": true,
  "version": "0.1.0",
  "description": "TemPro — monorepo (frontend + backend)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @tempro/frontend",
    "dev:api": "npm run dev -w @tempro/backend",
    "build": "npm run build -w @tempro/frontend",
    "build:api": "npm run build -w @tempro/backend",
    "preview": "npm run preview -w @tempro/frontend",
    "typecheck": "npm run typecheck -w @tempro/frontend",
    "typecheck:api": "npm run typecheck -w @tempro/backend",
    "db:migrate": "npm run db:migrate -w @tempro/backend",
    "db:seed": "npm run db:seed -w @tempro/backend",
    "db:generate": "npm run db:generate -w @tempro/backend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5"
  }
}
